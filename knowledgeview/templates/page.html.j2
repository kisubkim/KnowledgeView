<!DOCTYPE html>
<html lang="ko" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="kv-runtime" content="2">
<script type="application/json" id="kv-meta">{{ meta_json|safe }}</script>
<script>
(function(){try{var t=localStorage.getItem("kv-theme");if(!t){t=matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light"}document.documentElement.dataset.theme=t;if(localStorage.getItem("kv-hide-added")==="1")document.documentElement.classList.add("kv-hide-added")}catch(e){}})();
</script>
<style>
:root{
  --bg:#f6f7f9;--surface:#fff;--surface-2:#f1f3f6;--text:#1d2330;--muted:#5d6676;--border:#e2e6ec;
  --accent:#2f6fde;--accent-soft:#e8f0fd;--shadow:0 1px 2px rgba(16,24,40,.05),0 1px 3px rgba(16,24,40,.06);
  --c-note:#2f6fde;--c-tip:#1f9d63;--c-important:#7c4ddb;--c-warning:#c77700;--c-caution:#d0393e;
  --c-key:#2f6fde;--c-detail:#0f8b8d;--c-example:#1f9d63;--c-analogy:#b5539b;--c-pitfall:#c77700;--c-summary:#7c4ddb;
  --code-bg:#f7f8fa;--sidebar:280px;
  --font:"Pretendard","Pretendard Variable","Noto Sans KR","Malgun Gothic","Apple SD Gothic Neo",system-ui,sans-serif;
  --mono:"JetBrains Mono","D2Coding","Consolas","SFMono-Regular",monospace;
}
[data-theme=dark]{
  --bg:#0f1218;--surface:#171b23;--surface-2:#1e232d;--text:#e4e7ec;--muted:#98a2b3;--border:#2a303c;
  --accent:#6ea0ff;--accent-soft:#1c2a44;--shadow:none;--code-bg:#12161d;
  --c-note:#6ea0ff;--c-tip:#4cc38a;--c-important:#a98bf0;--c-warning:#e9a23b;--c-caution:#f06a6e;
  --c-key:#6ea0ff;--c-detail:#3cc0c2;--c-example:#4cc38a;--c-analogy:#e083c6;--c-pitfall:#e9a23b;--c-summary:#a98bf0;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:72px}
body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font);font-size:16px;line-height:1.75;-webkit-font-smoothing:antialiased;word-break:keep-all;overflow-wrap:anywhere}
a{color:var(--accent);text-decoration:none}a:hover{text-decoration:underline}
a.kv-dead-link{color:var(--muted);text-decoration:underline dotted}
.kv-progress{position:fixed;top:0;left:0;height:3px;background:var(--accent);width:0;z-index:30}
.kv-topbar{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:12px;padding:10px 20px;background:color-mix(in srgb,var(--surface) 88%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--border)}
.kv-topbar .kv-crumb{color:var(--muted);font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1}
.kv-topbar .kv-crumb b{color:var(--text);font-weight:600}
.kv-btn{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:8px;padding:5px 11px;font:inherit;font-size:13px;cursor:pointer;white-space:nowrap}
.kv-btn:hover{border-color:var(--accent);color:var(--accent)}
.kv-btn[aria-pressed=true]{background:var(--accent-soft);border-color:var(--accent);color:var(--accent)}
.kv-menu-btn{display:none}
.kv-layout{display:grid;grid-template-columns:var(--sidebar) minmax(0,1fr);max-width:1440px;margin:0 auto}
.kv-sidebar{position:sticky;top:53px;height:calc(100vh - 53px);overflow:auto;padding:24px 14px 40px 20px;border-right:1px solid var(--border)}
.kv-sidebar h2{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin:0 0 10px 8px}
.kv-toc{list-style:none;margin:0;padding:0;font-size:14px;line-height:1.45}
.kv-toc a{display:block;padding:5px 8px;border-radius:6px;color:var(--muted);border-left:2px solid transparent}
.kv-toc a:hover{background:var(--surface-2);color:var(--text);text-decoration:none}
.kv-toc a.active{color:var(--accent);background:var(--accent-soft);border-left-color:var(--accent);font-weight:600}
.kv-toc .l3 a{padding-left:22px;font-size:13px}
.kv-main{padding:32px clamp(16px,4vw,56px) 80px;min-width:0}
.kv-content{max-width:920px;margin:0 auto}
.kv-hero{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:32px 36px;box-shadow:var(--shadow);margin-bottom:24px;position:relative;overflow:hidden}
.kv-hero::before{content:"";position:absolute;inset:0 0 auto 0;height:4px;background:linear-gradient(90deg,var(--accent),var(--c-detail),var(--c-summary))}
.kv-hero h1{font-size:clamp(26px,3.4vw,36px);line-height:1.25;margin:4px 0 16px;letter-spacing:-.02em}
.kv-eyebrow{font-size:13px;color:var(--muted);display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.kv-badge{display:inline-block;font-size:12px;padding:2px 9px;border-radius:999px;background:var(--surface-2);color:var(--muted);border:1px solid var(--border)}
.kv-badge.mode-llm{background:var(--accent-soft);color:var(--accent);border-color:transparent}
.kv-meta{display:grid;grid-template-columns:max-content 1fr;gap:6px 16px;margin:0 0 18px;font-size:14px}
.kv-meta dt{color:var(--muted)}.kv-meta dd{margin:0}
.kv-stats{display:flex;gap:10px;flex-wrap:wrap}
.kv-stat{background:var(--surface-2);border-radius:10px;padding:8px 14px;font-size:13px;color:var(--muted)}
.kv-stat b{display:block;font-size:18px;color:var(--text)}
.kv-card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:28px 36px;box-shadow:var(--shadow);margin-bottom:24px}
.kv-overview h2,.kv-extra h2{margin-top:0}
.kv-overview .kv-summary{font-size:17px}
.kv-ov-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;margin-top:16px}
.kv-ov-grid>div{background:var(--surface-2);border-radius:12px;padding:16px 20px}
.kv-ov-grid h3{font-size:15px;margin:0 0 8px}
.kv-ov-grid ul{margin:0;padding-left:20px;font-size:15px}
.kv-section{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:8px 36px 24px;box-shadow:var(--shadow);margin-bottom:24px}
.kv-section-flag{font-size:12px;color:var(--c-warning);margin:16px 0 -8px}
.kv-body h2{font-size:26px;line-height:1.35;margin:28px 0 16px;padding-bottom:10px;border-bottom:1px solid var(--border);letter-spacing:-.01em}
.kv-body h3{font-size:20px;margin:32px 0 12px}
.kv-body h4{font-size:17px;margin:24px 0 8px}
.kv-body h2,.kv-body h3,.kv-body h4{position:relative}
.kv-body .kv-anchor{position:absolute;left:-22px;opacity:0;color:var(--muted);font-weight:400}
.kv-body h2:hover .kv-anchor,.kv-body h3:hover .kv-anchor,.kv-body h4:hover .kv-anchor{opacity:1}
.kv-body p{margin:12px 0}
.kv-body ul,.kv-body ol{padding-left:24px}
.kv-body li{margin:4px 0}
.kv-body strong{color:color-mix(in srgb,var(--text) 92%,var(--accent))}
.kv-body hr{border:0;border-top:1px solid var(--border);margin:28px 0}
.kv-body img{max-width:100%;border-radius:8px}
.kv-body :not(pre)>code{font-family:var(--mono);font-size:.88em;background:var(--surface-2);border:1px solid var(--border);border-radius:5px;padding:1px 5px}
.kv-body blockquote{margin:16px 0;padding:4px 18px;border-left:4px solid var(--border);color:var(--muted);background:var(--surface-2);border-radius:0 10px 10px 0}
.kv-table{overflow-x:auto;margin:16px 0;border:1px solid var(--border);border-radius:10px}
.kv-table table{border-collapse:collapse;width:100%;font-size:14.5px;line-height:1.55}
.kv-table th,.kv-table td{padding:9px 13px;border-bottom:1px solid var(--border);vertical-align:top}
.kv-table th{background:var(--surface-2);text-align:left;font-weight:600;white-space:nowrap}
.kv-table tr:last-child td{border-bottom:0}
.kv-table tbody tr:hover{background:color-mix(in srgb,var(--accent-soft) 45%,transparent)}
.kv-code{margin:16px 0;border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--code-bg)}
.kv-code-bar{display:flex;justify-content:space-between;align-items:center;padding:4px 8px 4px 14px;font-size:12px;color:var(--muted);border-bottom:1px solid var(--border);font-family:var(--mono)}
.kv-code-bar button{border:0;background:none;color:var(--muted);cursor:pointer;font-size:12px;padding:2px 6px;border-radius:5px}
.kv-code-bar button:hover{background:var(--surface-2);color:var(--text)}
.kv-code pre{margin:0;padding:14px 16px;overflow:auto;font-family:var(--mono);font-size:13.5px;line-height:1.6;background:transparent}
.kv-diagram{margin:20px 0;padding:16px;border:1px solid var(--border);border-radius:12px;background:var(--surface);position:relative;text-align:center;overflow-x:auto}
.kv-diagram pre.mermaid{margin:0;background:none;font-family:var(--mono);font-size:13px;text-align:left;white-space:pre-wrap}
.kv-diagram pre.mermaid[data-processed]{text-align:center}
.kv-diagram svg{max-width:100%;height:auto}
.kv-diagram-src{margin:12px 0 0;text-align:left;font-family:var(--mono);font-size:12.5px;background:var(--code-bg);padding:12px;border-radius:8px;overflow:auto}
.kv-diagram-tools{position:absolute;top:8px;right:8px;display:flex;gap:4px;opacity:0;transition:opacity .15s}
.kv-diagram:hover .kv-diagram-tools{opacity:1}
.kv-diagram-tools button{border:1px solid var(--border);background:var(--surface);color:var(--muted);border-radius:6px;font-size:12px;padding:2px 7px;cursor:pointer}
.kv-diagram-error{color:var(--c-caution);font-size:13px;margin-top:8px}
.kv-callout{margin:18px 0;border:1px solid color-mix(in srgb,var(--cc) 30%,var(--border));border-left:4px solid var(--cc);border-radius:10px;background:color-mix(in srgb,var(--cc) 6%,var(--surface));padding:12px 18px}
.kv-callout-title{font-weight:700;color:var(--cc);font-size:14.5px;margin-bottom:2px;display:flex;align-items:center;gap:6px}
.kv-callout-body>:first-child{margin-top:4px}.kv-callout-body>:last-child{margin-bottom:4px}
.kv-c-note{--cc:var(--c-note)}.kv-c-tip{--cc:var(--c-tip)}.kv-c-important{--cc:var(--c-important)}.kv-c-warning{--cc:var(--c-warning)}.kv-c-caution{--cc:var(--c-caution)}
.kv-c-key{--cc:var(--c-key)}.kv-c-detail{--cc:var(--c-detail)}.kv-c-example{--cc:var(--c-example)}.kv-c-analogy{--cc:var(--c-analogy)}.kv-c-pitfall{--cc:var(--c-pitfall)}.kv-c-summary{--cc:var(--c-summary)}
.kv-added{position:relative}
.kv-added::after{content:"보강";position:absolute;top:10px;right:12px;font-size:11px;color:var(--cc);border:1px solid currentColor;border-radius:999px;padding:0 7px;opacity:.7}
.kv-hide-added .kv-added,.kv-hide-added .kv-added-block{display:none}
.kv-figure{margin:20px 0;padding:14px;border:1px solid var(--border);border-radius:12px;background:var(--surface);text-align:center}
.kv-callout .kv-figure{background:var(--surface)}
.kv-figure img{max-width:100%;max-height:560px;height:auto;border-radius:8px;background:#fff}
.kv-figure figcaption{margin-top:10px;font-size:14px;color:var(--text);line-height:1.5}
.kv-figure .kv-credit{display:block;margin-top:4px;font-size:12px;color:var(--muted)}
.kv-figure .kv-credit a{color:var(--muted);text-decoration:underline}
.kv-glossary dl{display:grid;grid-template-columns:minmax(120px,max-content) 1fr;gap:10px 20px;margin:0}
.kv-glossary dt{font-weight:700}.kv-glossary dd{margin:0;color:var(--muted)}
.kv-quiz details{border:1px solid var(--border);border-radius:10px;padding:10px 16px;margin:10px 0;background:var(--surface-2)}
.kv-quiz summary{cursor:pointer;font-weight:600}
.kv-quiz details p{margin:10px 0 2px}
.kv-footer{color:var(--muted);font-size:13px;border-top:1px solid var(--border);margin-top:40px;padding-top:16px}
.kv-footer code{font-family:var(--mono);font-size:12px}
.kv-warn{color:var(--c-warning)}
.kv-lightbox{position:fixed;inset:0;background:rgba(10,12,16,.72);z-index:50;display:none;align-items:center;justify-content:center;padding:4vh 4vw}
.kv-lightbox.open{display:flex}
.kv-lightbox-inner{background:var(--surface);border-radius:14px;max-width:96vw;max-height:92vh;overflow:auto;padding:24px;position:relative}
.kv-lightbox-inner svg{max-width:none!important;height:auto;min-width:min(1200px,88vw)}
.kv-lightbox-close{position:sticky;top:0;float:right}
.kv-totop{position:fixed;right:24px;bottom:24px;z-index:15;opacity:0;pointer-events:none;transition:opacity .2s}
.kv-totop.show{opacity:1;pointer-events:auto}
{{ pygments_css|safe }}
@media (max-width:1000px){
  .kv-layout{grid-template-columns:1fr}
  .kv-menu-btn{display:inline-block}
  .kv-sidebar{position:fixed;top:53px;left:0;width:min(320px,86vw);background:var(--surface);z-index:25;transform:translateX(-102%);transition:transform .2s;box-shadow:0 8px 24px rgba(0,0,0,.2)}
  .kv-sidebar.open{transform:none}
  .kv-hero,.kv-card,.kv-section{padding-left:20px;padding-right:20px}
}
@media print{
  .kv-topbar,.kv-sidebar,.kv-progress,.kv-totop,.kv-diagram-tools{display:none!important}
  .kv-layout{display:block}.kv-main{padding:0}
  .kv-hero,.kv-card,.kv-section{box-shadow:none;break-inside:auto}
  body{background:#fff}
}
</style>
</head>
<body>
<div class="kv-progress" id="kv-progress"></div>
<header class="kv-topbar">
  <button type="button" class="kv-btn kv-menu-btn" id="kv-menu" aria-label="목차">☰</button>
  <a class="kv-btn" href="/" id="kv-home" title="문서 목록">← 목록</a>
  <div class="kv-crumb">{% if info.category %}{{ info.category }} / {% endif %}<b>{{ title }}</b></div>
  {% if info.mode != "none" %}<button type="button" class="kv-btn" id="kv-toggle-added" aria-pressed="true" title="LLM이 보강한 내용 표시/숨김">보강 내용 표시</button>{% endif %}
  <button type="button" class="kv-btn" id="kv-theme" title="밝게/어둡게">◐</button>
  <button type="button" class="kv-btn" onclick="print()" title="인쇄 / PDF 저장">인쇄</button>
</header>
<div class="kv-layout">
  <nav class="kv-sidebar" id="kv-sidebar">
    <h2>목차</h2>
    <ul class="kv-toc" id="kv-toc">
      {% if overview %}<li class="l2"><a href="#kv-overview">한눈에 보기</a></li>{% endif %}
      {% for t in toc %}<li class="l{{ t.level }}"><a href="#{{ t.id }}">{{ t.text }}</a></li>
      {% endfor %}
      {% if overview.glossary %}<li class="l2"><a href="#kv-glossary">용어 사전</a></li>{% endif %}
      {% if overview.quiz %}<li class="l2"><a href="#kv-quiz">확인 문제</a></li>{% endif %}
    </ul>
  </nav>
  <main class="kv-main">
    <div class="kv-content">
      <header class="kv-hero">
        <div class="kv-eyebrow">
          {% if info.category %}<span>{{ info.category }}</span><span>·</span>{% endif %}
          <span class="kv-badge{% if info.mode != "none" %} mode-llm{% endif %}">{{ info.mode_label }}</span>
          {% if info.model %}<span class="kv-badge">{{ info.model }}</span>{% endif %}
          {% if info.reasoning_effort %}<span class="kv-badge">effort: {{ info.reasoning_effort }}</span>{% endif %}
        </div>
        <h1>{{ title }}</h1>
        {% if doc_meta %}
        <dl class="kv-meta">
          {% for k, v in doc_meta %}<dt>{{ k }}</dt><dd>{{ v }}</dd>
          {% endfor %}
        </dl>
        {% endif %}
        <div class="kv-stats">
          <div class="kv-stat"><b>{{ stats.minutes }}분</b>예상 읽기 시간</div>
          <div class="kv-stat"><b>{{ sections|length }}</b>섹션</div>
          <div class="kv-stat"><b>{{ stats.diagrams }}</b>다이어그램</div>
          <div class="kv-stat"><b>{{ stats.tables }}</b>표</div>
          {% if stats.code %}<div class="kv-stat"><b>{{ stats.code }}</b>코드</div>{% endif %}
        </div>
      </header>

      {% if overview %}
      <section class="kv-card kv-overview{% if info.mode != 'none' %} kv-added-block{% endif %}" id="kv-overview">
        <h2>한눈에 보기</h2>
        {% if overview.summary %}<p class="kv-summary">{{ overview.summary }}</p>{% endif %}
        <div class="kv-ov-grid">
          {% if overview.objectives %}<div><h3>학습 목표</h3><ul>{% for o in overview.objectives %}<li>{{ o }}</li>{% endfor %}</ul></div>{% endif %}
          {% if overview.key_points %}<div><h3>핵심 포인트</h3><ul>{% for o in overview.key_points %}<li>{{ o }}</li>{% endfor %}</ul></div>{% endif %}
          {% if overview.prerequisites %}<div><h3>먼저 알아 두면 좋은 것</h3><ul>{% for o in overview.prerequisites %}<li>{{ o }}</li>{% endfor %}</ul></div>{% endif %}
        </div>
      </section>
      {% endif %}

      {% if intro_html %}<section class="kv-section kv-body">{{ intro_html|safe }}</section>{% endif %}

      {% for s in sections %}
      <section class="kv-section kv-body">
        {% if s.warning %}<p class="kv-section-flag">⚠ {{ s.warning }}</p>{% endif %}
        {{ s.html|safe }}
      </section>
      {% endfor %}

      {% if overview.glossary %}
      <section class="kv-card kv-glossary kv-added-block" id="kv-glossary">
        <h2>용어 사전</h2>
        <dl>{% for g in overview.glossary %}<dt>{{ g.term }}</dt><dd>{{ g.desc }}</dd>{% endfor %}</dl>
      </section>
      {% endif %}
      {% if overview.quiz %}
      <section class="kv-card kv-quiz kv-added-block" id="kv-quiz">
        <h2>확인 문제</h2>
        {% for q in overview.quiz %}<details><summary>Q{{ loop.index }}. {{ q.q }}</summary><p>{{ q.a }}</p></details>{% endfor %}
      </section>
      {% endif %}

      <footer class="kv-footer">
        <div>원본: <code>{{ info.source_rel or info.source_path }}</code></div>
        <div>생성: {{ info.generated_at }} · {{ info.mode_label }}{% if info.model %} ({{ info.model }}){% endif %} · {{ info.generator }}</div>
        {% for w in info.warnings %}<div class="kv-warn">⚠ {{ w }}</div>{% endfor %}
      </footer>
    </div>
  </main>
</div>
<button type="button" class="kv-btn kv-totop" id="kv-totop" title="맨 위로">↑</button>
<div class="kv-lightbox" id="kv-lightbox"><div class="kv-lightbox-inner"><button type="button" class="kv-btn kv-lightbox-close" id="kv-lightbox-close">닫기 ✕</button><div id="kv-lightbox-body"></div></div></div>
<script src="{{ asset_base }}/vendor/mermaid.min.js" defer></script>
<script src="{{ asset_base }}/kv-page.js" defer></script>
<script>
(function(){
  var root=document.documentElement, $=function(s,c){return (c||document).querySelector(s)}, $$=function(s,c){return Array.prototype.slice.call((c||document).querySelectorAll(s))};

  // Heading anchors
  $$(".kv-body h2[id],.kv-body h3[id],.kv-body h4[id]").forEach(function(h){var a=document.createElement("a");a.className="kv-anchor";a.href="#"+h.id;a.textContent="#";h.insertBefore(a,h.firstChild)});

  // Theme
  $("#kv-theme").onclick=function(){var t=root.dataset.theme==="dark"?"light":"dark";root.dataset.theme=t;try{localStorage.setItem("kv-theme",t)}catch(e){}};

  // Added-content toggle
  var tg=$("#kv-toggle-added");
  if(tg){var sync=function(){var h=root.classList.contains("kv-hide-added");tg.setAttribute("aria-pressed",String(!h));tg.textContent=h?"보강 내용 숨김":"보강 내용 표시"};sync();
    tg.onclick=function(){root.classList.toggle("kv-hide-added");try{localStorage.setItem("kv-hide-added",root.classList.contains("kv-hide-added")?"1":"0")}catch(e){}sync()}}

  // Mobile TOC
  var sb=$("#kv-sidebar");$("#kv-menu").onclick=function(){sb.classList.toggle("open")};
  $$("#kv-toc a").forEach(function(a){a.addEventListener("click",function(){sb.classList.remove("open")})});

  // Code copy
  $$(".kv-copy").forEach(function(b){b.onclick=function(){var code=b.closest(".kv-code").querySelector("code").innerText;
    var done=function(){b.textContent="복사됨";setTimeout(function(){b.textContent="복사"},1400)};
    if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(code).then(done)}else{var t=document.createElement("textarea");t.value=code;document.body.appendChild(t);t.select();document.execCommand("copy");t.remove();done()}}});

  // Scroll progress, scrollspy, back-to-top
  var links=$$("#kv-toc a"), targets=links.map(function(a){return document.getElementById(decodeURIComponent(a.hash.slice(1)))}), top=$("#kv-totop");
  top.onclick=function(){scrollTo({top:0})};
  var ticking=false;
  function onScroll(){var h=root.scrollHeight-innerHeight;$("#kv-progress").style.width=(h>0?scrollY/h*100:0)+"%";top.classList.toggle("show",scrollY>800);
    var cur=-1;for(var i=0;i<targets.length;i++){if(targets[i]&&targets[i].getBoundingClientRect().top<120)cur=i}
    links.forEach(function(a,i){a.classList.toggle("active",i===cur)});
    if(cur>=0){var a=links[cur],r=a.getBoundingClientRect(),sr=sb.getBoundingClientRect();if(r.top<sr.top||r.bottom>sr.bottom)a.scrollIntoView({block:"nearest"})}
    ticking=false}
  addEventListener("scroll",function(){if(!ticking){ticking=true;requestAnimationFrame(onScroll)}},{passive:true});onScroll();

  // Lightbox (filled by the app runtime: diagrams and figures)
  var lb=$("#kv-lightbox");
  $("#kv-lightbox-close").onclick=function(){lb.classList.remove("open")};
  lb.onclick=function(e){if(e.target===lb)lb.classList.remove("open")};
  addEventListener("keydown",function(e){if(e.key==="Escape")lb.classList.remove("open")});

  // Diagrams are rendered by the app runtime (/assets/kv-page.js + mermaid).
  addEventListener("load",function(){
    if(!window.KV_RUNTIME||!window.mermaid){$$(".kv-diagram").forEach(function(f){var d=document.createElement("div");d.className="kv-diagram-error";d.textContent="다이어그램 라이브러리를 불러오지 못했습니다(KnowledgeView 앱에서 열어야 그림으로 보입니다).";f.appendChild(d)})}
    if(location.hash){var t=document.getElementById(decodeURIComponent(location.hash.slice(1)));if(t)t.scrollIntoView()}
  });
})();
</script>
</body>
</html>
